{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Milestone watch",
  "description": "Vault tracks near round-number play counts (2026-10-11 snapshot).",
  "type": "object",
  "required": [
    "bands",
    "summit"
  ],
  "properties": {
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "target",
          "tracks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "target": {
            "type": "integer"
          },
          "blurb": {
            "type": "string"
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "plays",
                "needed",
                "page"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "plays": {
                  "type": "integer"
                },
                "needed": {
                  "type": "integer"
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "page": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "summit": {
      "type": "object"
    }
  }
}

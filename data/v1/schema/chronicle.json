{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "chronicle",
  "type": "object",
  "required": [
    "version",
    "generated",
    "plays_snapshot",
    "method",
    "kinds",
    "same_date_order",
    "eras",
    "collaborators",
    "events",
    "insights"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "plays_snapshot": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "same_date_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eras": {
      "type": "array"
    },
    "collaborators": {
      "type": "array"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "date",
          "kind",
          "era_id",
          "era_name",
          "title",
          "detail",
          "plays",
          "links",
          "collaborators"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "milestone",
              "session",
              "collaboration"
            ]
          },
          "era_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "era_name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "plays": {
            "type": [
              "integer",
              "null"
            ]
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "href"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "href": {
                  "type": "string"
                }
              }
            }
          },
          "collaborators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "collab_slug": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "insights": {
      "type": "object"
    }
  }
}

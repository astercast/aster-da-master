{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "eras",
  "description": "Era deep-dives: six eras with full transmission lists, all in-era collaborators, active codex families, milestones, computed signal lines and summaries. Generated by scripts/build_eras.py.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "plays_snapshot": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "archive_totals": {
      "type": "object",
      "properties": {
        "transmissions": {
          "type": "integer"
        },
        "plays": {
          "type": "integer"
        },
        "sessions": {
          "type": "integer"
        },
        "years": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "transmissions",
        "plays",
        "sessions"
      ]
    },
    "eras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "span": {
            "type": [
              "string",
              "null"
            ]
          },
          "years": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scene": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "era_releases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transmissions": {
            "type": "integer"
          },
          "plays": {
            "type": "integer"
          },
          "sessions": {
            "type": "integer"
          },
          "distributor": {
            "type": "integer"
          },
          "top_tracks": {
            "type": "array"
          },
          "key_sessions": {
            "type": "array"
          },
          "collaborators": {
            "type": "array"
          },
          "milestones": {
            "type": "array"
          },
          "signal": {
            "type": "string"
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ordinal": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "plays": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "page": {
                  "type": "string"
                }
              },
              "required": [
                "ordinal",
                "title",
                "date",
                "type",
                "plays",
                "page"
              ]
            }
          },
          "codex_families": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "transmissions": {
                  "type": "integer"
                },
                "plays": {
                  "type": "integer"
                },
                "page": {
                  "type": "string"
                },
                "top_tracks": {
                  "type": "array"
                }
              },
              "required": [
                "name",
                "transmissions",
                "plays",
                "page"
              ]
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "rank_by_plays": {
                "type": "integer"
              },
              "rank_by_transmissions": {
                "type": "integer"
              },
              "eras_total": {
                "type": "integer"
              },
              "archive_plays_share": {
                "type": "number"
              },
              "busiest_year": {
                "type": "object"
              },
              "loudest_transmission": {
                "type": "object"
              },
              "deepest_cut": {
                "type": "object"
              },
              "collaborators_count": {
                "type": "integer"
              },
              "collab_plays": {
                "type": "integer"
              },
              "collab_plays_share": {
                "type": "number"
              },
              "top_family": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "milestones_count": {
                "type": "integer"
              }
            },
            "required": [
              "rank_by_plays",
              "rank_by_transmissions",
              "eras_total",
              "archive_plays_share",
              "busiest_year",
              "loudest_transmission",
              "deepest_cut",
              "collaborators_count",
              "collab_plays_share",
              "milestones_count"
            ]
          },
          "deep_dive": {
            "type": "string"
          },
          "journey": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "transmissions",
          "plays",
          "top_tracks",
          "key_sessions",
          "collaborators",
          "milestones",
          "signal",
          "tracks",
          "codex_families",
          "summary",
          "deep_dive",
          "journey"
        ]
      }
    }
  },
  "required": [
    "version",
    "archive_totals",
    "eras"
  ]
}

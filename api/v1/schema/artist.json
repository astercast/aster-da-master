{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArtistRecord",
  "description": "The canonical Aster da Master record. Only verified facts; research_status gates publication.",
  "type": "object",
  "required": [
    "version",
    "observed",
    "research_status",
    "artist"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "observed": {
      "format": "date"
    },
    "research_status": {
      "type": "string"
    },
    "artist": {
      "type": "object",
      "required": [
        "name",
        "tagline"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "genre": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "discography": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "type"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO date; null when unknown (e.g. SoundCloud-vault tracks)"
          },
          "type": {
            "type": "string"
          },
          "tracks": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "artwork": {
            "type": "string",
            "format": "uri"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "source": {
            "type": "string",
            "description": "Provenance: which platform/profile the record came from and when verified"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "verified",
              "single-source",
              "uncertain"
            ]
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "label",
                "url"
              ]
            }
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "socials": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "featured_release": {
      "type": [
        "object",
        "null"
      ]
    },
    "booking": {
      "type": [
        "object",
        "null"
      ]
    },
    "eras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "span",
          "scene",
          "releases"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "span": {
            "type": "string"
          },
          "scene": {
            "type": "string"
          },
          "releases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "collaborators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          }
        }
      }
    },
    "vault": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "tracks_on_record": {
          "type": "integer"
        },
        "confidence": {
          "type": "string"
        },
        "full_catalog": {
          "type": "string"
        },
        "research_date": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "tracks_on_record",
        "research_date"
      ]
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "codex-families",
  "description": "Codex family deep-dives: the 16 vocabulary families with decoded readings, era-by-era evolution, key sessions, and title-credited collaborators. Generated by scripts/build_codex_pages.py.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "plays_snapshot": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "family_count": {
      "type": "integer"
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "epithet": {
            "type": "string"
          },
          "words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "page": {
            "type": "string"
          },
          "track_count": {
            "type": "integer"
          },
          "total_plays": {
            "type": "integer"
          },
          "decoded": {
            "type": "object",
            "properties": {
              "reading": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "stated",
                  "unknown"
                ]
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "reading",
              "status",
              "source"
            ]
          },
          "first_appearance": {
            "$ref": "#/definitions/tx"
          },
          "latest": {
            "$ref": "#/definitions/tx"
          },
          "eras": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "span": {
                  "type": "string"
                },
                "transmissions": {
                  "type": "integer"
                },
                "plays": {
                  "type": "integer"
                },
                "loudest": {
                  "$ref": "#/definitions/tx"
                },
                "deep_dive": {
                  "type": "string"
                },
                "journey": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "span",
                "transmissions",
                "plays",
                "loudest",
                "deep_dive",
                "journey"
              ]
            }
          },
          "transmissions": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/txfull"
            }
          },
          "key_sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "start": {
                  "type": "string"
                },
                "end": {
                  "type": "string"
                },
                "family_transmissions": {
                  "type": "integer"
                },
                "family_plays": {
                  "type": "integer"
                },
                "deep_dive": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "page": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "start",
                "end",
                "family_transmissions",
                "family_plays",
                "page"
              ]
            }
          },
          "collaborators": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "page": {
                  "type": "string"
                },
                "transmissions": {
                  "type": "integer"
                },
                "plays": {
                  "type": "integer"
                }
              },
              "required": [
                "slug",
                "name",
                "page",
                "transmissions",
                "plays"
              ]
            }
          }
        },
        "required": [
          "name",
          "slug",
          "epithet",
          "words",
          "page",
          "track_count",
          "total_plays",
          "decoded",
          "first_appearance",
          "latest",
          "eras",
          "transmissions",
          "key_sessions",
          "collaborators"
        ]
      }
    }
  },
  "definitions": {
    "tx": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "plays": {
          "type": [
            "integer",
            "null"
          ]
        },
        "page": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "date",
        "plays",
        "page"
      ]
    },
    "txfull": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "plays": {
          "type": [
            "integer",
            "null"
          ]
        },
        "type": {
          "type": "string"
        },
        "page": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "date",
        "plays",
        "type",
        "page"
      ]
    }
  },
  "required": [
    "version",
    "generated",
    "plays_snapshot",
    "method",
    "family_count",
    "families"
  ]
}

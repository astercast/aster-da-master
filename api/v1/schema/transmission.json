{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "The guided-journey era aggregates: six eras with transmissions, plays, sessions, top tracks, key sessions, collaborators, milestones, and computed signal lines \u2014 plus a 2026 extras block on The Return era (the four verified 2026 singles, the Q4 2026 Uncle-LP/trilogy watch, the play-count snapshot). Generated by scripts/build_transmission.py.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "plays_snapshot": {
      "type": "string"
    },
    "archive_totals": {
      "type": "object",
      "properties": {
        "transmissions": {
          "type": "integer"
        },
        "plays": {
          "type": "integer"
        },
        "sessions": {
          "type": "integer"
        },
        "years": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "transmissions",
        "plays",
        "sessions"
      ]
    },
    "longest_gap": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer"
        },
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "eras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "span": {
            "type": [
              "string",
              "null"
            ]
          },
          "years": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scene": {
            "type": [
              "string",
              "null"
            ]
          },
          "transmissions": {
            "type": "integer"
          },
          "plays": {
            "type": "integer"
          },
          "sessions": {
            "type": "integer"
          },
          "distributor": {
            "type": "integer"
          },
          "top_tracks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "plays": {
                  "type": "integer"
                },
                "date": {
                  "type": "string"
                },
                "page": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "title",
                "plays",
                "date",
                "page"
              ]
            }
          },
          "key_sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "track_count": {
                  "type": "integer"
                },
                "total_plays": {
                  "type": "integer"
                },
                "days": {
                  "type": "integer"
                },
                "start": {
                  "type": "string"
                },
                "end": {
                  "type": "string"
                },
                "deep_dive": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "track_count",
                "total_plays"
              ]
            }
          },
          "collaborators": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "transmissions": {
                  "type": "integer"
                },
                "plays": {
                  "type": "integer"
                },
                "page": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "transmissions",
                "plays",
                "page"
              ]
            }
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "fact": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "fact"
              ]
            }
          },
          "signal": {
            "type": "string"
          },
          "extras": {
            "type": "object",
            "description": "2026-era extras (The Return only): the verified 2026 singles, the Q4 2026 watch, the play-count snapshot.",
            "properties": {
              "singles_2026": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string"
                    },
                    "page": {
                      "type": "string"
                    },
                    "source": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "title",
                    "date",
                    "page"
                  ]
                }
              },
              "singles_note": {
                "type": "string"
              },
              "q4_watch": {
                "type": "object",
                "properties": {
                  "uncle": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "expected": {
                        "type": "string"
                      },
                      "as_of": {
                        "type": "string"
                      },
                      "note": {
                        "type": "string"
                      },
                      "figure_page": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "label",
                      "status",
                      "expected",
                      "as_of",
                      "figure_page"
                    ]
                  },
                  "trilogy": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string"
                      },
                      "page": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "title",
                      "status",
                      "source",
                      "page"
                    ]
                  }
                },
                "required": [
                  "uncle",
                  "trilogy"
                ]
              },
              "snapshot": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "date",
                  "note"
                ]
              }
            },
            "required": [
              "singles_2026",
              "q4_watch",
              "snapshot"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "transmissions",
          "plays",
          "top_tracks",
          "key_sessions",
          "collaborators",
          "milestones",
          "signal"
        ]
      }
    }
  },
  "required": [
    "version",
    "archive_totals",
    "eras"
  ]
}

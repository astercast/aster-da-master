{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "The guided-journey era aggregates: six eras with transmissions, plays, sessions, top tracks, key sessions, collaborators, milestones, and computed signal lines. Generated by scripts/build_transmission.py.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "plays_snapshot": {
      "type": "string"
    },
    "archive_totals": {
      "type": "object",
      "properties": {
        "transmissions": {
          "type": "integer"
        },
        "plays": {
          "type": "integer"
        },
        "sessions": {
          "type": "integer"
        },
        "years": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "transmissions",
        "plays",
        "sessions"
      ]
    },
    "longest_gap": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer"
        },
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "eras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "span": {
            "type": [
              "string",
              "null"
            ]
          },
          "years": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scene": {
            "type": [
              "string",
              "null"
            ]
          },
          "transmissions": {
            "type": "integer"
          },
          "plays": {
            "type": "integer"
          },
          "sessions": {
            "type": "integer"
          },
          "distributor": {
            "type": "integer"
          },
          "top_tracks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "plays": {
                  "type": "integer"
                },
                "date": {
                  "type": "string"
                },
                "page": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "title",
                "plays",
                "date",
                "page"
              ]
            }
          },
          "key_sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "track_count": {
                  "type": "integer"
                },
                "total_plays": {
                  "type": "integer"
                },
                "days": {
                  "type": "integer"
                },
                "start": {
                  "type": "string"
                },
                "end": {
                  "type": "string"
                },
                "deep_dive": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "track_count",
                "total_plays"
              ]
            }
          },
          "collaborators": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "transmissions": {
                  "type": "integer"
                },
                "plays": {
                  "type": "integer"
                },
                "page": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "transmissions",
                "plays",
                "page"
              ]
            }
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "fact": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "fact"
              ]
            }
          },
          "signal": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "transmissions",
          "plays",
          "top_tracks",
          "key_sessions",
          "collaborators",
          "milestones",
          "signal"
        ]
      }
    }
  },
  "required": [
    "version",
    "archive_totals",
    "eras"
  ]
}

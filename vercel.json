{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "installCommand": "echo 'no dependencies'",
  "trailingSlash": false,
  "buildCommand": "python3 scripts/api_manifest.py && python3 scripts/strip_public.py && python3 scripts/write_health.py"
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/api_manifest.py",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/signal",
      "schedule": "0 16 * * *"
    }
  ],
  "functions": {
    "api/cron/signal.js": {
      "maxDuration": 10
    },
    "api/health.js": {
      "maxDuration": 10
    },
    "api/stats.js": {
      "maxDuration": 10
    },
    "api/uploads.js": {
      "maxDuration": 10
    },
    "api/watch.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ],
      "source": "/api/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ],
      "source": "/data/v1/(.*)"
    },
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "installCommand": "echo 'no dependencies'",
  "trailingSlash": false
}
